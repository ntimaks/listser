# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Reminder emails (optional; see README "Reminder emails"). Server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_your-resend-key
REMINDERS_FROM="Listser <reminders@your-domain.com>"
# Long random string, also stored in Supabase Vault as reminders_cron_secret.
REMINDERS_CRON_SECRET=
